# Copy to integrations/librechat/.env.local (ignored by Git). Never commit secrets.
BASTILLA_API_BASE_URL=http://host.docker.internal:3000
# Must match BASTILLA_LIVE_CHAT_ALLOWED_ORIGIN configured on the Bastilla server.
BASTILLA_LIVE_CHAT_ALLOWED_ORIGIN=http://localhost:3000
BASTILLA_LIVE_CHAT_USER_PASSWORD=
# Generate a unique 32+ byte secret: openssl rand -hex 32
BASTILLA_BRIDGE_API_KEY=
